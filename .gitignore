# .gitignore

# -----------------------------------------------------------------------------
# General Python
# -----------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions and local native build products
*.so
*.dylib
*.dll
*.pyd

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.whl

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Virtual environment
.venv/
env/
venv/
reliquary-env/  # Your Conda environment directory
# Note: For collaborative projects, it's often better to include poetry.lock to ensure everyone uses the exact same dependencies.

# IDEs and Editors
.vscode/
.idea/          # IntelliJ / PyCharm
*.sublime-project
*.sublime-workspace
.DS_Store       # macOS-specific
*.bak
*.swp
*.tmp

# -----------------------------------------------------------------------------
# Rust
# -----------------------------------------------------------------------------
# Cargo build directory
target/
visualizer/vulkan/build/

# Keep Cargo.lock when a Rust crate is promoted to a shipped binary. The
# current PyO3 crates are library crates, so their lockfiles are not required.
rust_modules/**/Cargo.lock

# -----------------------------------------------------------------------------
# Node.js
# -----------------------------------------------------------------------------
# Node.js modules
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# Project-Specific Files
# -----------------------------------------------------------------------------
# Temporary configuration and data files
config/trust_defaults.json
config/vault_trust_templates.yaml
config/vaults/
config/api_config.py # This should be read from env vars, not committed
data/
tmp/
runtime/

# Secret files
*.env
.env.*
.secrets/

# WebAuthn database
auth/webauthn/keys.db
*.db
*.sqlite
*.sqlite3

# Merkle-logged audit trail and test data
audit_logs/
logs/
apps/api/logs/
vaults/test_data/
vaults/data/
zk/trust_data/
test_logs/
orchestrator_*/*
*.mem

# Notebook scratch files
.ipynb_checkpoints/
**/.ipynb_checkpoints/
Untitled*.ipynb

# ZK-SNARKs temporary files
# These files are often large and should not be in git
zk/proofs/
zk/verifier/groth16.json
zk/verifier/*.json
zk/verifier/*.wtns
zk/verifier/*.zkey
zk/verifier/*.ptau
zk/verifier/build/
zk/verifier/**/*.json
zk/verifier/**/*.wtns
zk/verifier/**/*.zkey
zk/verifier/**/*.ptau
zk/circom/

# Benchmark and assessment output
assessment-results/
benchmark_results.md
evaluation_tables.md
*_benchmark_results.json
*_results.json
*_comparison.png
*_success_rates.png
*_response_times.png
*_distribution.png
*_analysis.png
performance_comparison.png
success_rates.png
comprehensive_behavior_test_results.png

# -----------------------------------------------------------------------------
# Next.js Website
# -----------------------------------------------------------------------------
# Next.js build output
website/.next/
website/out/

# Next.js development files
website/.env*.local
website/.vercel/
website/.vscode/
website/coverage/
website/.nyc_output/
website/*.log
website/npm-debug.log*
website/yarn-debug.log*
website/yarn-error.log*

# Dependencies
website/node_modules/

# Testing
website/.jest/
website/jest/
website/jest.config.js

# Typescript
website/*.tsbuildinfo

# Public directory build artifacts
website/public/build/
website/public/_next/

# Ignore all .next content but not the directory itself
website/.next/*
!website/.next/.gitkeep

# -----------------------------------------------------------------------------
# SDK Specific
# -----------------------------------------------------------------------------
# Go SDK
sdk/go/bin/
sdk/go/pkg/
sdk/go/src/

# Java SDK
sdk/java/target/
sdk/java/bin/
sdk/java/.gradle/
sdk/java/build/
sdk/java/*.iml
sdk/java/*.iws
sdk/java/*.ipr
sdk/java/out/
sdk/java/atlassian-ide-plugin.xml
sdk/java/.settings/
sdk/java/.project
sdk/java/.classpath
sdk/java/.metadata
sdk/java/.DS_Store


*.tex
.next/
.vercel
