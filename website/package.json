{
  "name": "reliquary-website",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal open-source ReliQuary demo website",
  "scripts": {
    "dev": "next dev -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "preview": "next build && next start -p ${PORT:-3000}",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.11",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.52.0",
    "eslint-config-next": "^15.5.2",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "cryptography",
    "security",
    "vault",
    "secrets",
    "audit-log",
    "zero-knowledge"
  ],
  "author": "ReliQuary contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SwayamSingal/ReliQuary.git"
  }
}
